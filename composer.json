{
    "name": "contenir/tracking",
    "description": "Framework-free analytics and tracking tags for Contenir: tag definitions (Google tag, Tag Manager, Meta pixel, LinkedIn Insight), Consent Mode v2, ID validation and snippet rendering with a CSP nonce.",
    "type": "library",
    "license": "BSD-3-Clause",
    "keywords": [
        "contenir",
        "analytics",
        "tracking",
        "gtag",
        "consent-mode",
        "csp"
    ],
    "homepage": "https://contenir.com.au",
    "support": {
        "issues": "https://github.com/contenir/contenir-tracking/issues",
        "source": "https://github.com/contenir/contenir-tracking"
    },
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0"
    },
    "require-dev": {
        "contenir/contenir-qa-tools": "0.1.x-dev",
        "infection/infection": "^0.34.1",
        "phpunit/phpunit": "^11.5.42"
    },
    "autoload": {
        "psr-4": {
            "Contenir\\Tracking\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Contenir\\Tracking\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@static-analysis",
            "@test",
            "@test-integration",
            "@mutation-test"
        ],
        "cs-check": [
            "mago format --check",
            "mago lint"
        ],
        "cs-fix": [
            "mago format",
            "mago lint --fix"
        ],
        "static-analysis": "mago analyze",
        "test": "phpunit --colors=always --testsuite unit",
        "test-integration": "phpunit --colors=always --testsuite integration",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml",
        "mutation-test": "infection"
    },
    "config": {
        "platform": {
            "php": "8.3.99"
        },
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
